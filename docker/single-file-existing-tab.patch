+async function getCurrentPdfUrl({ Runtime }, { options, debugMessages }) {
+	await Runtime.enable();
+	try {
+		const { result } = await Runtime.evaluate({
+			expression: "document.contentType === 'application/pdf' ? location.href : ''",
+			returnByValue: true
+		});
+		return typeof result.value === "string" ? result.value : "";
+	} catch (error) {
+		logData(["Unable to inspect the current document type", error.message], { options, debugMessages });
+		return "";
+	} finally {
+		await Runtime.disable();
+	}
+}
